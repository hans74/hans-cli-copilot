---
import type { Category, Publisher } from '../types/game';

interface Props {
    categories: Category[];
    publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
---

<form
    role="search"
    aria-label="Filter games"
    class="mb-8 bg-slate-800/60 border border-slate-700/50 rounded-xl p-6 flex flex-col gap-6 md:flex-row md:items-start"
    data-testid="game-filters"
>
    <fieldset class="flex-1 min-w-0">
        <legend class="text-sm font-medium text-slate-300 mb-3">Categories</legend>
        <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
                <label class="inline-flex items-center gap-2 text-sm text-slate-200 cursor-pointer">
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`filter-category-${category.id}`}
                    />
                    {category.name}
                </label>
            ))}
        </div>
    </fieldset>

    <div class="md:w-64">
        <label for="filter-publisher" class="block text-sm font-medium text-slate-300 mb-3">Publisher</label>
        <select
            id="filter-publisher"
            name="publisher"
            class="w-full rounded-lg bg-slate-900 border border-slate-600 text-slate-100 text-sm px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="filter-publisher"
        >
            <option value="">All publishers</option>
            {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
        </select>
    </div>

    <div class="md:self-end">
        <button
            type="reset"
            class="rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-100 text-sm font-medium px-4 py-2 transition-colors focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="filter-clear"
        >
            Clear filters
        </button>
    </div>
</form>
