---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import GameFilters from '../components/GameFilters.astro';
import { getAllGames, getAllCategories, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
        <GameFilters categories={categories} publishers={publishers} />
        <p class="text-sm text-slate-400 mb-4" role="status" aria-live="polite" data-testid="filter-result-count" id="filter-result-count"></p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
        <div id="filter-empty" class="hidden" data-testid="filter-empty">
          <EmptyState text="No games match the selected filters." />
        </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const count = document.getElementById('filter-result-count');
  const empty = document.getElementById('filter-empty');

  if (form && count && empty) {
    const categoryBoxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisher = form.querySelector<HTMLSelectElement>('select[name="publisher"]')!;

    const apply = (): void => {
      const selected = categoryBoxes.filter((box) => box.checked).map((box) => box.value);
      let visible = 0;
      for (const card of cards) {
        const matchesCategory = selected.length === 0 || selected.includes(card.dataset.categoryId ?? '');
        const matchesPublisher = publisher.value === '' || card.dataset.publisherId === publisher.value;
        const show = matchesCategory && matchesPublisher;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
      }
      count.textContent = `Showing ${visible} of ${cards.length} games`;
      empty.classList.toggle('hidden', visible !== 0);

      const params = new URLSearchParams();
      selected.forEach((id) => params.append('category', id));
      if (publisher.value) params.set('publisher', publisher.value);
      const query = params.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname);
    };

    const params = new URLSearchParams(location.search);
    const initialCategories = params.getAll('category');
    categoryBoxes.forEach((box) => (box.checked = initialCategories.includes(box.value)));
    publisher.value = params.get('publisher') ?? '';
    if (publisher.value !== (params.get('publisher') ?? '')) publisher.value = '';

    form.addEventListener('change', apply);
    form.addEventListener('reset', () => setTimeout(apply));
    apply();
  }
</script>
